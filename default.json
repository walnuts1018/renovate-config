{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.7.5",
    ":separateMultipleMajorReleases",
    ":timezone(Asia/Tokyo)",
    "github>walnuts1018/renovate-config:assign",
    "github>walnuts1018/renovate-config:automerge",
    "github>walnuts1018/renovate-config:docker",
    "github>walnuts1018/renovate-config:GitHubActions",
    "github>walnuts1018/renovate-config:golang",
    "github>walnuts1018/renovate-config:helm",
    "github>walnuts1018/renovate-config:node",
    "github>walnuts1018/renovate-config:npm",
    "github>walnuts1018/renovate-config:reviewers",
    "github>walnuts1018/renovate-config:rust",
    "github>walnuts1018/renovate-config:vulnerabilityAlerts"
  ],
  "labels": [
    "renovate"
  ],
  "configMigration": true,
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Dockerfile-[^/]*$/"
    ]
  },
  "npm": {
    "rangeStrategy": "bump"
  },
  "dependencyDashboard": true,
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "platformAutomerge": false,
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 100
}
