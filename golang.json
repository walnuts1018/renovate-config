{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Goのバージョンをgo.mod・mise・Dockerfileで揃える",
      "matchDatasources": [
        "golang-version",
        "github-tags",
        "docker"
      ],
      "matchPackageNames": [
        "/^(go|golang\\/go|(?:docker\\.io\\/)?(?:library\\/)?golang)$/"
      ],
      "groupName": "Go"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "github.com/aws/{/,}**"
      ],
      "groupName": "Go AWS SDK"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "go.opentelemetry.io/{/,}**"
      ],
      "groupName": "Go OpenTelemetry"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "github.com/gocql/gocql",
        "github.com/scylladb/gocql",
        "github.com/scylladb/gocqlx/v3"
      ],
      "groupName": "Go ScyllaDB/gocql"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
