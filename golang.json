{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "github.com/aws/{/,}**"
      ],
      "groupName": "Go AWS SDK"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "go.opentelemetry.io/{/,}**"
      ],
      "groupName": "Go OpenTelemetry"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "github.com/gocql/gocql",
        "github.com/scylladb/gocql",
        "github.com/scylladb/gocqlx/v3"
      ],
      "groupName": "Go ScyllaDB/gocql"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ]
}
