{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "pin": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "aquaproj/aqua-registry",
        "terraform"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "@types/**"
      ],
      "automerge": true,
      "major": {
        "automerge": false
      }
    }
  ]
}
